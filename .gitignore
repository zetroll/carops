# =====================================================
# incubator-ops .gitignore
# =====================================================
# Single-tenant fork — most "user data" is committed
# (founder name, startup name, customer logos, etc. are
# already in kraft.md / founder.md). What stays untracked
# below is genuinely sensitive or generated.

# Sensitive (never commit)
.env
data/dpiit-certificate.pdf
data/llp-moa.pdf
config/profile.yml

# Generated reports / outputs
reports/applications/
reports/outreach/
reports/ic-prep/
output/

# Tooling
node_modules/
package-lock.json
bun.lock
.resolved-prompt-*

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
